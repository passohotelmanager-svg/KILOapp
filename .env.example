# 복사해서 .env.local 로 저장한 뒤 값을 채우세요. (.env.local 은 git에 올라가지 않습니다)
#
# 아래 두 값은 Supabase 대시보드 > Project Settings > API 에서 확인합니다.
# 둘 다 앱(브라우저)에 들어가도 되는 "공개" 값입니다. 행 단위 보안(RLS)으로 데이터가 보호됩니다.
#
# 절대 여기에 넣지 마세요: service_role / secret 키, GEMINI_API_KEY
#   - GEMINI_API_KEY 는 Supabase Edge Function 의 비밀값으로만 등록합니다.
#       supabase secrets set GEMINI_API_KEY=...
#
# 값이 없으면 AI 추천은 기록 기반 규칙 추천으로 대신 동작합니다.

VITE_SUPABASE_URL=https://프로젝트ID.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_여기에_붙여넣기
